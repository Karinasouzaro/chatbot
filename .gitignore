# =============================================================================
# .gitignore — RAIZ DO PROJETO (AfesuTech Chatbot)
# =============================================================================

# ─── Python / Backend ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.venv/
env/
venv/
ENV/
.env                    # ← NUNCA sobe para o GitHub
backend/.env            # proteção dupla explícita
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# ─── Node.js / Frontend ──────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
.env.local
.env.*.local

# ─── Logs & temporários ──────────────────────────────────────────────────────
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── Editores / OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Testes & cobertura ──────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml
