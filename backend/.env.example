# =============================================================================
# AFESUTECH CHATBOT - EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# =============================================================================

# Chave de API da Groq (obtenha gratuitamente em https://console.groq.com/keys)
GROQ_API_KEY=gsk_sua_chave_aqui

# Modelo LLM da Groq a ser utilizado
GROQ_MODEL=llama-3.3-70b-versatile

# Configurações do Servidor Backend
PORT=8000
HOST=0.0.0.0
